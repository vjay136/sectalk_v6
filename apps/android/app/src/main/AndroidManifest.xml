<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="false"
        android:icon="@drawable/sectalk_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.SecTalk.Launcher"
        android:usesCleartextTraffic="false">
        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />
        <!-- SecTalk does not use Android Browser Helper's optional static shortcuts. -->
        <activity android:name="com.google.androidbrowserhelper.trusted.ShortcutTrampolineActivity" tools:node="remove" />
        <activity android:name="com.google.androidbrowserhelper.trusted.ColdShortcutActivity" tools:node="remove" />

        <activity android:name=".SecTalkActivity" android:exported="true">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="@string/launch_url" />
            <meta-data android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY" android:value="customtabs" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="sectalk-v6-pilot.vercel.app" />
                <data android:path="/" />
                <data android:path="/auth/confirm" />
                <data android:path="/auth/workspace-sso" />
                <data android:path="/auth/scim-claim" />
                <data android:path="/invite" />
                <data android:path="/room-guest" />
                <data android:path="/meeting-guest" />
                <data android:path="/shared-file" />
                <data android:pathPrefix="/workspace-file/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
