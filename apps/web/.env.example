NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Vercel defaults to the Free release. Set full only after the full release gate passes.
SECTALK_RELEASE_SCOPE=free
# Enable only after configuring native Supabase passkeys and the app's relying-party origin.
# NEXT_PUBLIC_SECTALK_PASSKEYS_ENABLED=true
# Server only. The device enrollment endpoint verifies key possession before binding a native session.
# SECTALK_DEVICE_BUNDLE_SERVICE_KEY=
# Optional private native Auth upstream for the app password sign-in gateway.
# SECTALK_AUTH_PASSWORD_UPSTREAM=
# Required for signup unless SECTALK_AUTH_RISK_SERVICE_KEY is already configured. Enable the native Before User Created hook.
# SECTALK_SIGNUP_ADMISSION_SERVICE_KEY=
# SECTALK_AUTH_SIGNUP_UPSTREAM=
# SECTALK_AUTH_RISK_SERVICE_KEY=
# SECTALK_AUTH_RISK_IDENTIFIER_SECRET=
# SECTALK_AUTH_RISK_FEED_URL=
# SECTALK_AUTH_RISK_FEED_PUBLIC_KEY=

# Set the stable deployment origin (no trailing slash) for Stripe and security.txt.
SECTALK_APP_URL=https://your-deployment.example.com
# Optional comma-separated SHA-256 fingerprints of approved Android signing certificates.
# SECTALK_ANDROID_CERT_SHA256=
# Optional comma-separated HTTPS origins for browser-based Workspace API reads with API keys.
# SECTALK_WORKSPACE_API_CORS_ORIGINS=

# Optional server-side SMTP for workspace invitation emails. Use 465, 587 or 2525.
# SECTALK_INVITE_SMTP_HOST=
# SECTALK_INVITE_SMTP_PORT=587
# SECTALK_INVITE_SMTP_FROM=
# SECTALK_INVITE_SMTP_USER=
# SECTALK_INVITE_SMTP_PASSWORD=

# Configure an independently verified private reporting contact per deployment.
# SECTALK_SECURITY_CONTACT=
# SECTALK_SECURITY_CONTACT_EXPIRES=

# Server-side only. Use a v6 Supabase secret/service role key and a separate random signing secret of at least 32 bytes.
# SECTALK_FILE_STORAGE_KEY=
# SECTALK_FILE_TICKET_SECRET=
# Optional private ClamAV worker. Setting either variable activates the fail-closed scan gate.
# SECTALK_MALWARE_SCANNER_URL=
# SECTALK_MALWARE_SCANNER_SECRET=
# Schedule POST /api/files/purge with Authorization: Bearer <purge secret>.
# SECTALK_FILE_PURGE_SECRET=

# Optional read-only provider key deletion attestor for staged workspace offboarding.
# SECTALK_PROVIDER_ERASURE_URL=https://your-attestor.example.com/v1/provider-key-erasure
# SECTALK_PROVIDER_ERASURE_TOKEN=

# Optional first-page PDF previews. Configure a separate isolated raster worker and matching secret.
# SECTALK_PDF_PREVIEW_WORKER_URL=
# SECTALK_PDF_WORKER_SECRET=

# Optional server-only Supabase secret/service role key for aggregate API operational metrics.
# SECTALK_METRICS_SERVER_KEY=

# Optional server-only Ed25519 private key, base64url-encoded PKCS #8 DER, for workspace audit exports.
# Publish the trusted public-key fingerprint independently so recipients can verify downloads.
# SECTALK_AUDIT_SIGNING_PRIVATE_KEY=

# Optional media service for audio and video inside scheduled group meetings.
# LIVEKIT_URL=wss://your-instance.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Self-hosted signaling gateway and private LiveKit control API.
# LIVEKIT_INTERNAL_URL=https://private-livekit-control.example.com
# LIVEKIT_SIGNAL_AUTH_SECRET=
# LIVEKIT_SIGNAL_SERVICE_KEY=
# Server-side only. Use a newly provisioned Supabase secret key for billing writes.
# Hosted v6 defaults to free. Enable paid billing only after provider acceptance.
SECTALK_BILLING_MODE=free
# SECTALK_BILLING_SUPABASE_KEY=
# Set optional for a no-card 14-day workspace trial or required for Stripe card verification.
# SECTALK_WORKSPACE_TRIALS=optional
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_BASIC_MONTHLY=
# STRIPE_PRICE_BASIC_ANNUAL=
# STRIPE_PRICE_PROFESSIONAL_MONTHLY=
# STRIPE_PRICE_PROFESSIONAL_ANNUAL=
# STRIPE_PRICE_BUSINESS_MONTHLY=
# STRIPE_PRICE_BUSINESS_ANNUAL=
# Workspace recurring seat Price IDs are configured as STRIPE_WORKSPACE_SEAT_<CURRENCY>_<MONTHLY|ANNUAL>.
# STRIPE_WORKSPACE_SEAT_USD_MONTHLY=
# STRIPE_WORKSPACE_SEAT_USD_ANNUAL=

# Optional Razorpay-hosted checkout for verified INR offers. Keep the credentials server-only.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_BASIC_MONTHLY=
# RAZORPAY_PLAN_BASIC_ANNUAL=
# RAZORPAY_PLAN_PROFESSIONAL_MONTHLY=
# RAZORPAY_PLAN_PROFESSIONAL_ANNUAL=
# RAZORPAY_PLAN_BUSINESS_MONTHLY=
# RAZORPAY_PLAN_BUSINESS_ANNUAL=

# Optional Stripe tax quotes. Configure approved merchant registrations, currency and Stripe tax behavior first.
# SECTALK_STRIPE_TAX=enabled
# SECTALK_GST_SELLER_STATE=
# SECTALK_GST_RATE_BPS=
# STRIPE_GST_CGST_INCLUSIVE=
# STRIPE_GST_CGST_EXCLUSIVE=
# STRIPE_GST_SGST_INCLUSIVE=
# STRIPE_GST_SGST_EXCLUSIVE=
# STRIPE_GST_UTGST_INCLUSIVE=
# STRIPE_GST_UTGST_EXCLUSIVE=
# STRIPE_GST_IGST_INCLUSIVE=
# STRIPE_GST_IGST_EXCLUSIVE=

# Optional private OpenTelemetry receiver. Use an HTTPS base URL for deployments.
# SECTALK_OTLP_ENDPOINT=
# SECTALK_OTLP_BEARER_TOKEN=

# Server-only workspace REST API and signed webhook worker.
# SECTALK_INTEGRATIONS_SUPABASE_KEY=
# SECTALK_WEBHOOK_ENCRYPTION_KEY=
# SECTALK_WEBHOOK_DRAIN_SECRET=
# Private Auth and SCIM credentials. Use the separate release project and exact Auth callback allowlists.
# SECTALK_SSO_SERVICE_KEY=
# SECTALK_SSO_AUTH_URL=
# SECTALK_SCIM_SERVICE_KEY=

# Optional STUN override. Configure one TURN provider for relay-only calls.
# STUN_URL=stun:stun.example.com:3478
# Self-hosted Coturn
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=
# Turnix Free rejects new credentials at its traffic allowance. Keep the project token server-side.
# TURNIX_API_TOKEN=
# CALL_DIAGNOSTICS_STUN_URL=stun:diagnostic-turn.example.com:3478
# CALL_DIAGNOSTICS_TURN_URLS=turn:diagnostic-turn.example.com:3478?transport=udp,turn:diagnostic-turn.example.com:3478?transport=tcp,turns:diagnostic-turn.example.com:443?transport=tcp
# CALL_DIAGNOSTICS_TURN_SECRET=
# CALL_DIAGNOSTICS_BANDWIDTH=1
# MEETING_RECORDING_SERVICE_KEY=
# MEETING_RECORDING_S3_ENDPOINT=https://project.example.com/storage/v1/s3
# MEETING_RECORDING_S3_ACCESS_KEY=
# MEETING_RECORDING_S3_SECRET=
# MEETING_RECORDING_S3_REGION=us-east-1
# MEETING_RECORDING_WEBHOOK_URL=https://sectalk.example.com/api/meetings/recordings/webhook

# Optional offline meeting captions. Run services/meeting-captions/worker.py on the app host.
# MEETING_CAPTIONS_SERVICE_KEY=
# MEETING_CAPTIONS_WORKER_URL=http://127.0.0.1:3495/transcribe
# MEETING_CAPTIONS_WORKER_TOKEN=
# For a separate dedicated worker under the same operator, set the exact HTTPS origin and use its /transcribe URL above.
# SECTALK_SPEECH_WORKER_HTTPS_ORIGIN=

# Optional guest meetings. Configure a Turnstile widget restricted to the guest page hostname.
# MEETING_GUEST_SERVICE_KEY=
# MEETING_GUEST_TURNSTILE_SITE_KEY=
# MEETING_GUEST_TURNSTILE_SECRET=
# MEETING_GUEST_CAPTCHA_HOSTNAME=sectalk.example.com

# Optional read-only room guest links. Keep the database service key server-side.
# ROOM_GUEST_SERVICE_KEY=

# Optional protected LiveKit meeting setup. This key is never used to transport media keys.
# PROTECTED_MEETING_SERVICE_KEY=

# Optional direct-chat voice notes. Use a random 32-byte hex encryption key held by the app server.
# VOICE_NOTE_SERVICE_KEY=
# VOICE_NOTE_ENCRYPTION_KEY=

# Optional browser push. Keep the Supabase service key, VAPID private key, and
# dispatch secret server-side. Generate one stable VAPID key pair per deployment.
# SECTALK_PUSH_SERVICE_KEY=
# SECTALK_VAPID_PUBLIC_KEY=
# SECTALK_VAPID_PRIVATE_KEY=
# SECTALK_VAPID_SUBJECT=mailto:push@example.com
# SECTALK_PUSH_DISPATCH_SECRET=
# Call POST /api/push/dispatch from a scheduler with Authorization: Bearer <dispatch secret>.
# Dispatch frequently enough for 30-second incoming call alerts.

# Optional notification email and scheduled digests. Invitation SMTP settings are independent.
# SECTALK_NOTIFICATION_SUPABASE_KEY=
# SECTALK_NOTIFICATION_SMTP_HOST=
# SECTALK_NOTIFICATION_SMTP_PORT=587
# SECTALK_NOTIFICATION_SMTP_FROM=
# SECTALK_NOTIFICATION_SMTP_USER=
# SECTALK_NOTIFICATION_SMTP_PASSWORD=
# SECTALK_NOTIFICATION_DRAIN_SECRET=
# SECTALK_APP_URL=https://your-sectalk.example.com
# Call POST /api/notification-email/drain each minute with Authorization: Bearer <drain secret>.

# Scheduled operational reports reuse the notification SMTP settings and Supabase service key.
# SECTALK_REPORT_DRAIN_SECRET=
# Call POST /api/operational-reports/drain with Authorization: Bearer <report drain secret>.

# Server-only Supabase service role key for the fixed synthetic rule evaluation endpoint.
# SECTALK_RULE_REGISTRY_SERVICE_KEY=

# Optional URL inspection sidecar. The app only accepts an exact loopback /inspect endpoint.
# SECTALK_URL_INSPECTION_WORKER_URL=http://127.0.0.1:3531/inspect
# SECTALK_URL_INSPECTION_WORKER_TOKEN=
# Worker-only configuration (see docs/URL_INSPECTION.md).
# SECTALK_URL_INSPECTION_PORT=3531
# SECTALK_URL_INSPECTION_ALLOWED_HOSTS=
# SECTALK_URL_REPUTATION_FILE=
# SECTALK_URL_REPUTATION_PUBLIC_KEY_FILE=

# Organization settings. See docs/organization-settings.md.
SECTALK_ORG_DOMAIN_SERVICE_KEY=
SECTALK_ORG_DNS_SERVER=
SECTALK_ORG_INFRA_REGION=
SECTALK_ORG_INFRA_REGION_REFERENCE=

# Server-side map of approved residency target project references to exact application origins.
# SECTALK_RESIDENCY_ROUTING_ORIGINS={"target-project-reference":"https://destination.example.com"}
