NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Set the stable deployment origin (no trailing slash) for Stripe and security.txt.
SECTALK_APP_URL=https://your-deployment.example.com

# Optional server-side SMTP for workspace invitation emails. Use 465, 587 or 2525.
# SECTALK_INVITE_SMTP_HOST=
# SECTALK_INVITE_SMTP_PORT=587
# SECTALK_INVITE_SMTP_FROM=
# SECTALK_INVITE_SMTP_USER=
# SECTALK_INVITE_SMTP_PASSWORD=

# Configure an independently verified private reporting contact per deployment.
# SECTALK_SECURITY_CONTACT=
# SECTALK_SECURITY_CONTACT_EXPIRES=

# Server-side only. Use a v6 Supabase secret/service role key and a separate random signing secret of at least 32 bytes.
# SECTALK_FILE_STORAGE_KEY=
# SECTALK_FILE_TICKET_SECRET=
# Optional private ClamAV worker. Setting either variable activates the fail-closed scan gate.
# SECTALK_MALWARE_SCANNER_URL=
# SECTALK_MALWARE_SCANNER_SECRET=
# Schedule POST /api/files/purge with Authorization: Bearer <purge secret>.
# SECTALK_FILE_PURGE_SECRET=

# Optional first-page PDF previews. Configure a separate isolated raster worker and matching secret.
# SECTALK_PDF_PREVIEW_WORKER_URL=
# SECTALK_PDF_WORKER_SECRET=

# Optional server-only Supabase secret/service role key for aggregate API operational metrics.
# SECTALK_METRICS_SERVER_KEY=

# Optional server-only Ed25519 private key, base64url-encoded PKCS #8 DER, for workspace audit exports.
# Publish the trusted public-key fingerprint independently so recipients can verify downloads.
# SECTALK_AUDIT_SIGNING_PRIVATE_KEY=

# Optional media service for audio and video inside scheduled group meetings.
# LIVEKIT_URL=wss://your-instance.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Server-side only. Use a newly provisioned Supabase secret key for billing writes.
# SECTALK_BILLING_SUPABASE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_BASIC_MONTHLY=
# STRIPE_PRICE_BASIC_ANNUAL=
# STRIPE_PRICE_PROFESSIONAL_MONTHLY=
# STRIPE_PRICE_PROFESSIONAL_ANNUAL=
# STRIPE_PRICE_BUSINESS_MONTHLY=
# STRIPE_PRICE_BUSINESS_ANNUAL=

# Optional STUN override and short-lived Coturn credentials for a relay-only deployment.
# STUN_URL=stun:stun.example.com:3478
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# CALL_DIAGNOSTICS_STUN_URL=stun:diagnostic-turn.example.com:3478
# CALL_DIAGNOSTICS_TURN_URLS=turn:diagnostic-turn.example.com:3478?transport=udp,turn:diagnostic-turn.example.com:3478?transport=tcp,turns:diagnostic-turn.example.com:443?transport=tcp
# CALL_DIAGNOSTICS_TURN_SECRET=
# CALL_DIAGNOSTICS_BANDWIDTH=1
# MEETING_RECORDING_SERVICE_KEY=
# MEETING_RECORDING_S3_ENDPOINT=https://project.example.com/storage/v1/s3
# MEETING_RECORDING_S3_ACCESS_KEY=
# MEETING_RECORDING_S3_SECRET=
# MEETING_RECORDING_S3_REGION=us-east-1
# MEETING_RECORDING_WEBHOOK_URL=https://sectalk.example.com/api/meetings/recordings/webhook

# Optional offline meeting captions. Run services/meeting-captions/worker.py on the app host.
# MEETING_CAPTIONS_SERVICE_KEY=
# MEETING_CAPTIONS_WORKER_URL=http://127.0.0.1:3495/transcribe
# MEETING_CAPTIONS_WORKER_TOKEN=
# TURN_SHARED_SECRET=

# Optional browser push. Keep the Supabase service key, VAPID private key, and
# dispatch secret server-side. Generate one stable VAPID key pair per deployment.
# SECTALK_PUSH_SERVICE_KEY=
# SECTALK_VAPID_PUBLIC_KEY=
# SECTALK_VAPID_PRIVATE_KEY=
# SECTALK_VAPID_SUBJECT=mailto:push@example.com
# SECTALK_PUSH_DISPATCH_SECRET=
# Call POST /api/push/dispatch from a scheduler with Authorization: Bearer <dispatch secret>.
# Dispatch frequently enough for 30-second incoming call alerts.

# Optional notification email and scheduled digests. Invitation SMTP settings are independent.
# SECTALK_NOTIFICATION_SUPABASE_KEY=
# SECTALK_NOTIFICATION_SMTP_HOST=
# SECTALK_NOTIFICATION_SMTP_PORT=587
# SECTALK_NOTIFICATION_SMTP_FROM=
# SECTALK_NOTIFICATION_SMTP_USER=
# SECTALK_NOTIFICATION_SMTP_PASSWORD=
# SECTALK_NOTIFICATION_DRAIN_SECRET=
# SECTALK_APP_URL=https://your-sectalk.example.com
# Call POST /api/notification-email/drain each minute with Authorization: Bearer <drain secret>.

# Scheduled operational reports reuse the notification SMTP settings and Supabase service key.
# SECTALK_REPORT_DRAIN_SECRET=
# Call POST /api/operational-reports/drain with Authorization: Bearer <report drain secret>.
