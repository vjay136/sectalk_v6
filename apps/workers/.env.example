# Point to the separate v6 Supabase project and the public v6 web origin.
NEXT_PUBLIC_SUPABASE_URL=https://your-v6-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SECTALK_APP_URL=https://your-v6-app.example.com

# Scheduled managed rotation and on-demand managed DEK rewrap.
# Use independent random bearer secrets with at least 32 bytes each.
# The wrapping key must match the v6 web environment for existing envelopes.
# CRON_SECRET=
# SECTALK_DEK_REWRAP_SECRET=
# SECTALK_FILE_STORAGE_KEY=
# SECTALK_KMS_WRAPPING_KEY=

# File, group file, export and workspace-file maintenance jobs.
# SECTALK_FILE_PURGE_SECRET=

# Stripe billing reconciliation and renewal reminders.
# The webhook signing secret belongs to the web project.
# STRIPE_SECRET_KEY=
# SECTALK_BILLING_SUPABASE_KEY=
# SECTALK_STRIPE_RECONCILE_SECRET=
# SECTALK_RENEWAL_MAIL_SECRET=

# Notification email, operational reports and Stripe renewal SMTP.
# SECTALK_NOTIFICATION_SUPABASE_KEY=
# SECTALK_NOTIFICATION_DRAIN_SECRET=
# SECTALK_REPORT_DRAIN_SECRET=
# SECTALK_NOTIFICATION_SMTP_HOST=
# SECTALK_NOTIFICATION_SMTP_PORT=587
# SECTALK_NOTIFICATION_SMTP_FROM=
# SECTALK_NOTIFICATION_SMTP_USER=
# SECTALK_NOTIFICATION_SMTP_PASSWORD=

# Signed webhooks and SIEM delivery. Use the v6 web webhook wrapping key.
# SECTALK_INTEGRATIONS_SUPABASE_KEY=
# SECTALK_WEBHOOK_ENCRYPTION_KEY=
# SECTALK_WEBHOOK_DRAIN_SECRET=
# SECTALK_SIEM_SERVICE_KEY=
# SECTALK_SIEM_DRAIN_SECRET=
# SECTALK_SIEM_SIGNING_KEY=
# SECTALK_SIEM_CONNECTORS=[]

# Web Push dispatch. Use the same stable VAPID pair as the v6 web app.
# SECTALK_PUSH_SERVICE_KEY=
# SECTALK_VAPID_PUBLIC_KEY=
# SECTALK_VAPID_PRIVATE_KEY=
# SECTALK_VAPID_SUBJECT=mailto:push@example.com
# SECTALK_PUSH_DISPATCH_SECRET=
