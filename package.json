{
  "name": "sectalk",
  "version": "6.0.0-alpha.1",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": "^24.7.0 || 26.x"
  },
  "scripts": {
    "dev": "npm run dev -w @sectalk/web",
    "build": "npm run build -w @sectalk/web",
    "start": "npm run start -w @sectalk/web",
    "typecheck": "npm run typecheck -w @sectalk/web",
    "test": "node --test tests/*.test.mjs",
    "preflight": "node scripts/preflight.mjs",
    "verify:registry": "node scripts/verify-registry.mjs",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "verify:tenant-isolation": "node scripts/verify-tenant-isolation.mjs"
  }
}
